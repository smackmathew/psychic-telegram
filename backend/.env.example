# Postgres connection string
DATABASE_URL=postgresql://dashboard:dashboard@localhost:5432/household_dashboard

# JWT
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS: comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# Plaid (https://dashboard.plaid.com) - leave blank to disable bank sync
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_PRODUCTS=transactions,investments
PLAID_COUNTRY_CODES=US

# Notification rule thresholds
LARGE_TRANSACTION_THRESHOLD=500
BUDGET_WARNING_PCT=0.9
UPCOMING_BILL_LEAD_DAYS=3
IDLE_CASH_INVESTMENT_THRESHOLD=10000

# Background sync/notification-check interval, in minutes
SCHEDULER_INTERVAL_MINUTES=60

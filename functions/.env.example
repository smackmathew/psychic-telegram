# Copy to functions/.env before deploying. (The Plaid secret is not set here: run
# `firebase functions:secrets:set PLAID_SECRET` so it's kept in Google Secret Manager.)

# From https://dashboard.plaid.com/developers/keys. Leave blank to turn bank sync off.
PLAID_CLIENT_ID=
# sandbox or production
PLAID_ENV=sandbox
# Your time zone, so "due today" and monthly budgets line up with your calendar.
TIME_ZONE=America/New_York
